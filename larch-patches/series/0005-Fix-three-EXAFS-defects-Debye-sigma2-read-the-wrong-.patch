-               ftwin, nfft, irbkg, nclamp, clamp_lo, clamp_hi)
+               ftwin, nfft, irbkg, nclamp, clamp_lo, clamp_hi, edge_step)
 
     lsout = leastsq(_resid, vcoefs, userargs, maxfev=2000*(ncoefs+1),
                     gtol=0.0, ftol=1.e-6, xtol=1.e-6, epsfcn=1.e-6,
